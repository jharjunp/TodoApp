app TodoApp {
  wasp: {
    version: "^0.11.3"
  },
  title: "TodoApp",
  dependencies: [
    ("recharts", "^2.8.0")
  ],

  auth: {
    // Tells Wasp which entity to use for storing users.
    userEntity: User,
    methods: {
      // Enable username and password auth.
      usernameAndPassword: {}
    },
    // We'll see how this is used a bit later.
    onAuthFailedRedirectTo: "/login"
  },
  db: { 
    system: PostgreSQL
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  authRequired: true,
  component: import Main from "@client/MainPage.jsx"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import Signup from "@client/SignupPage.jsx"
}

route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@client/LoginPage.jsx"
}

entity User {=psl
    id       Int    @id @default(autoincrement())
    username String @unique
    password String
    tasks       Task[]
    relays      Relay[]
psl=}
entity Task {=psl
    id          Int     @id @default(autoincrement())
    description String
    isDone      Boolean @default(false)
    user        User    @relation(fields: [userId], references: [id])
    userId      Int
psl=}
entity Hinnat {=psl
    id       Int    @id @default(autoincrement())
    hinnat   Json
psl=}
entity Relay {=psl
    id          Int     @id @default(autoincrement())
    logic       Int     @default(1)
    description String
    hours       Int     @default(24)
    temp_1      Int     @default(19)
    temp_2      Int     @default(16)
    price_1     Float   @default(3.0)
    price_2     Float   @default(10.0)
    isOn        Boolean
    SetOn       Boolean
    deviceID    String  @default("kokko")
    apiKey      String  @default("kokko")
    user        User    @relation(fields: [userId], references: [id])
    userId      Int
psl=}

query getTasks {
  fn: import { getTasks } from "@server/queries.js",
  entities: [Task]
}
query getXCheapestHours {
  fn: import { getXCheapestHours } from "@server/queries.js",
  entities: [Hinnat]
}
query getRelays {
  fn: import { getRelays } from "@server/queries.js",
  entities: [Relay]
}

action createHinnat {
  fn: import { createHinnat } from "@server/actions.js",
  entities: [Hinnat]
}
action createTask {
  fn: import { createTask } from "@server/actions.js",
  entities: [Task]
}
action updateTask {
  fn: import { updateTask } from "@server/actions.js",
  entities: [Task]
}
action updateRelaysLogic_1 {
  fn: import { updateRelaysLogic_1 } from "@server/actions.js",
  entities: [Relay, Hinnat]
}
action updateRelaysLogic_2 {
  fn: import { updateRelaysLogic_2 } from "@server/actions.js",
  entities: [Relay, Hinnat]
}
action sensiboPost {
  fn: import { sensiboPost } from "@server/actions.js",
  entities: [Relay]
}

job UpdateHinnat {
  executor: PgBoss,
  perform: {
    fn: import { getPrices } from "@server/workers.js",
    executorOptions: {
      pgBoss: {=json { "retryLimit": 1 } json=}
    }
  },
  schedule: {
//    cron: "* * * * *",
    cron: "0 11 * * *",
    //args: {=json { "foo": "bar" } json=},
    executorOptions: {
      pgBoss: {=json { "retryLimit": 0 } json=}
    }
  },
  entities: [Hinnat],
}
job updateRelaysJob {
  executor: PgBoss,
  perform: {
    fn: import { uRelays } from "@server/workers.js",
    executorOptions: {
      pgBoss: {=json { "retryLimit": 1 } json=}
    }
  },
  schedule: {
    cron: "* * * * *",
//    cron: "0 * * * *",
    //args: {=json { "foo": "bar" } json=},
    executorOptions: {
      pgBoss: {=json { "retryLimit": 0 } json=}
    }
  },
  entities: [],
}