app TodoApp {
  wasp: {
    version: "^0.11.3"
  },
  title: "Reilu Rele",
  dependencies: [
    ("recharts", "^2.8.0"),
    ("axios", "^1.4.0"),
    ("react", "^18.2.0"),
    ("react-dom", "^18.2.0"),
    ("bootstrap", "^5.3.2"),
    ("react-bootstrap", "^2.9.0"),
    ("react-helmet", "^6.1.0"),
    ("react-transition-group", "^4.4.5"),
    ("luxon", "^3.4.3")
  ],

  auth: {
    // Tells Wasp which entity to use for storing users.
    userEntity: User,
    methods: {
      // Enable username and password auth.
      usernameAndPassword: {}
    },
    // We'll see how this is used a bit later.
    onAuthFailedRedirectTo: "/"
  },
  db: { 
    system: PostgreSQL
  }
}

route landingRoute { path: "/", to: landing }
page landing {
  authRequired: false ,
  component: import Main from "@client/landingPage.jsx"
}
route RootRoute { path: "/page2", to: MainPage }
page MainPage {
  authRequired: true,
  component: import Main from "@client/Pages/Page2/MainPage.jsx"
}
route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import Signup from "@client/Pages/SignupPage.jsx"
}
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@client/Pages/LoginPage.jsx"
}

entity User {=psl
    id        Int    @id @default(autoincrement())
    username  String @unique
    password  String
    relays    Relay[]
    Logs      Log[]
psl=}
entity PriceData {=psl
    id          Int    @id @default(autoincrement())
    timeStamp   DateTime  @unique
    price       Float
psl=}
entity Relay {=psl
    id          Int     @id @default(autoincrement())
    type        Int     @default(1)
    logic       Int     @default(1)
    description String  @default("Uusi rele")
    hours       Int     @default(24)
    temp_1      Int     @default(19)
    temp_2      Int     @default(16)
    price_1     Float   @default(3.0)
    price_2     Float   @default(10.0)
    isOn        Boolean @default(false)
    SetOn       Boolean @default(false)
    deviceID    String  @unique
    apiKey      String  @default("")
    Logs        Log[]
    user        User    @relation(fields: [userId], references: [id])
    userId      Int
psl=}
entity Log {=psl
    id          Int    @id @default(autoincrement())
    timeStamp   DateTime
    outcome     Boolean  
    logEntry    Json
    relay       Relay @relation(fields: [relayId], references: [id], onDelete: Cascade)
    relayId     Int
    user        User   @relation(fields: [userId], references: [id])
    userId      Int
psl=}

query getRelays {
  fn: import { getRelays } from "@server/queries.js",
  entities: [Relay]
}
query getTodaysPrices {
  fn: import { getTodaysPrices } from "@server/queries.js",
  entities: [PriceData]
}
query getLogs {
  fn: import { getLogs } from "@server/queries.js",
  entities: [Log]
}
query getLatestOutcomesPerRelay {
  fn: import { getLatestOutcomesPerRelay } from "@server/queries.js",
  entities: [Relay]
}

action createRelay {
  fn: import { createRelay } from "@server/actions.js",
  entities: [Relay]
}
action editRelay {
  fn: import { editRelay } from "@server/actions.js",
  entities: [Relay]
}
action deleteRelay {
  fn: import { deleteRelay } from "@server/actions.js",
  entities: [Relay, Log]
}
action updatePrices {
  fn: import { updatePrices } from "@server/actions.js",
  entities: [PriceData]
}
action triggerHourly {
  fn: import { triggerHourly } from "@server/actions.js",
  entities: [PriceData]
}

job dailyJob {
  executor: PgBoss,
  perform: {
    fn: import { dailyWorker } from "@server/workers.js",
    executorOptions: {
      pgBoss: {=json { "retryLimit": 1 } json=}
    }
  },
  schedule: {
//    cron: "* * * * *",
    cron: "0 12,13,03 * * *", 
    executorOptions: {
      pgBoss: {=json { "retryLimit": 0 } json=}
    }
  },
  entities: [],
}
job hourlyJob {
  executor: PgBoss,
  perform: {
    fn: import { hourlyWorker } from "@server/workers.js",
    executorOptions: {
      pgBoss: {=json { "retryLimit": 1 } json=}
    }
  },
  schedule: {
//    cron: "* * * * *",
    cron: "1 * * * *",
    executorOptions: {
      pgBoss: {=json { "retryLimit": 0 } json=}
    }
  },
  entities: [Relay, Log],
}